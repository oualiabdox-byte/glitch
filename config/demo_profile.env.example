# Safe cTrader demo profile for the canonical strategy + Volume-Cycle allocator.
# Copy locally to .env or config/ctrader_credentials.env and fill credentials separately.
# Never commit real credentials.
CTRADER_ENV=demo
CTRADER_ALLOW_ORDERS=false
CTRADER_DEMO_EXECUTE=false
CTRADER_DEMO_CONFIRM=I_UNDERSTAND_DEMO_TRADING
CTRADER_RUN_UNTIL_TRADE=false
CTRADER_POLL_SECONDS=300
CTRADER_BASE_ORDER_VOLUME_UNITS=800
CTRADER_ORDER_VOLUME_UNITS=800
CTRADER_MAX_ORDER_VOLUME_UNITS=1000
CTRADER_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD

# Portfolio guards used in the validated backtest.
CTRADER_MAX_OPEN_POSITIONS=3
CTRADER_MAX_OPEN_PER_PAIR=1
CTRADER_RISK_PER_TRADE_PCT=0.5
CTRADER_MAX_DAILY_LOSS_R=3.0

# Keep the tested canonical strategy and execution assumptions.
CTRADER_INTRABAR_POLICY=sl_first
CTRADER_ROUND_TURN_COST_PIPS=1.5
CTRADER_ALLOCATOR=volume_cycle_adaptive
CTRADER_ALLOCATOR_MIN_WEIGHT=0.02
CTRADER_M5_CONFIRMATION_MODE=BOS_AFTER_CHOCH
CTRADER_LIQUIDITY_REGIME=true
CTRADER_REQUIRE_DISPLACEMENT=true
CTRADER_MIN_DISPLACEMENT_RATIO=1.0
# The 24-day validation did not support enabling this trailing mode yet.
CTRADER_DYNAMIC_STOP_MODE=DISABLED
CTRADER_CYCLE_TARGET_BARS=96
CTRADER_CYCLE_VOLUME_LOOKBACK_BARS=96
CTRADER_CYCLE_HISTORY_CYCLES=6

# Position sizing: fixed preserves existing behavior; risk is opt-in.
CTRADER_SIZING_MODE=fixed
CTRADER_ORDER_VOLUME_UNITS=1000
CTRADER_MAX_ORDER_VOLUME_UNITS=1000
# Required only when CTRADER_SIZING_MODE=risk.
# CTRADER_ACCOUNT_EQUITY=10000
# CTRADER_RISK_PER_TRADE_PCT=0.005
# CTRADER_CASH_PER_UNIT_PRICE_MOVE=1.0
