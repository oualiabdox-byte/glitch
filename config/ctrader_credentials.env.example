# Copy this file to config/ctrader_credentials.env locally.
# NEVER commit the copied file or paste real credentials into this template.

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ENV=demo

# Safety defaults: keep both disabled for data download/backtesting.
CTRADER_ALLOW_ORDERS=false
CTRADER_DEMO_EXECUTE=false
