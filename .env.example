# cTrader Open API -- copy this file to .env and never commit real values.
# The project loads .env automatically through python-dotenv.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ENV=demo
# Optional after account authorization; otherwise the first authorized account is used.
CTRADER_ACCOUNT_ID=
# Safe probe mode. Set the following three demo controls as shown below only
# when you are ready to allow automatic orders on the cTrader DEMO account.
# CTRADER_ALLOW_ORDERS=true means the adapter may submit demo orders.
# CTRADER_DEMO_EXECUTE=true means the automatic all-pairs runner is enabled.
# CTRADER_DEMO_CONFIRM=I_UNDERSTAND_DEMO_TRADING confirms intentional demo use.
CTRADER_ALLOW_ORDERS=false
CTRADER_DEMO_EXECUTE=false
CTRADER_DEMO_CONFIRM=
CTRADER_RUN_UNTIL_TRADE=true
CTRADER_POLL_SECONDS=300
CTRADER_DIAGNOSTICS_PATH=results/demo_diagnostics.jsonl
CTRADER_DATABASE_PATH=results/trading.db
CTRADER_STORAGE_LIMIT_MB=550
CTRADER_ORDER_VOLUME_UNITS=1000
# Live confirmation is intentionally ignored by the demo runner.
CTRADER_CONFIRM_LIVE=
# Use a positive cap at least as large as CTRADER_ORDER_VOLUME_UNITS when
# enabling demo execution.
CTRADER_MAX_ORDER_VOLUME_UNITS=0
CTRADER_LOOKBACK_DAYS=30
CTRADER_MAX_QUOTE_AGE_SECONDS=60
CTRADER_SWING_LENGTH=2
CTRADER_MIN_RR=0
CTRADER_STOP_BUFFER=0
CTRADER_ALLOW_WEAK_STRUCTURE=true
CTRADER_ALLOW_EQUILIBRIUM_OVERLAPPING_FVG=true
CTRADER_SETUP_MAX_AGE_HOURS=72
CTRADER_M5_CONFIRMATION_MODE=CHOCH_OR_BOS
CTRADER_SVL_REQUIRE_ALIGNMENT=false
CTRADER_SVL_PROFILE_BINS=24
CTRADER_SVL_EQUAL_TOLERANCE_PCT=0.001
