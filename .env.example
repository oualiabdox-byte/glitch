# cTrader Open API -- copy this file to .env and never commit real values.
# The project loads .env automatically through python-dotenv.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ENV=demo
# Optional after account authorization; otherwise the first authorized account is used.
CTRADER_ACCOUNT_ID=
# Safety gate. Keep false during integration/testing.
CTRADER_ALLOW_ORDERS=false
# Required for deliberate demo execution; live routing is not implemented.
CTRADER_DEMO_CONFIRM=
# Live confirmation is intentionally ignored by the demo runner.
CTRADER_CONFIRM_LIVE=
# Required positive hard cap for demo order volume in units.
CTRADER_MAX_ORDER_VOLUME_UNITS=0
